---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { documents, documentHref, resources, resourceHref, verifiedAt } from '../data/catalog.mjs';
const bySlug = (slug: string) => documents.find((item) => item.slug === slug)!;
const readingPath = [
  { label: '首次使用', range: '快速开始 · 01–02', slugs: ['quickstart', 'hpc-overview', 'login-and-ssh'] },
  { label: '运行实验前', range: '03–07', slugs: ['storage-and-data', 'slurm-basics', 'debug-and-interactive', 'software-environment', 'training-and-batch'] },
  { label: '参考', range: '08–10 · 速查', slugs: ['pricing-and-budget', 'results-and-reproducibility', 'troubleshooting', 'cheatsheet'] },
].map((stage) => ({ ...stage, items: stage.slugs.map(bySlug) }));
const chapterCount = documents.filter((item) => item.number).length;
---
<SiteLayout title="使用手册" home>
  <section class="home-hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>HKUST(GZ) · HPC 二期 · SSH + Slurm</div>
      <h1>HKUST(GZ) HPC<br /><span>使用手册</span></h1>
      <p class="hero-description">登录集群、提交作业、取回结果的基本流程，以及计费与数据保存要点。<br class="desktop-break" />基于官方文档精简整理，命令可直接复制。</p>
      <div class="hero-actions"><a class="button button-primary" href="/guide/quickstart/">快速开始<Icon name="arrow" size={18} /></a><a class="button button-secondary" href="/guide/cheatsheet/">命令速查<Icon name="code" size={17} /></a></div>
      <div class="hero-tags"><span><Icon name="check" size={14} />debug 分区免费，最长 30 分钟</span><span><Icon name="check" size={14} />CPU 0.02 元/核·小时</span><span><Icon name="clock" size={14} />官方信息核验于 {verifiedAt}</span></div>
    </div>
    <div class="hero-terminal">
      <div class="terminal-titlebar"><span class="terminal-dots"><i></i><i></i><i></i></span><span>SSH + Slurm</span><span class="terminal-platform">HPC Ⅱ</span></div>
      <div class="terminal-body">
        <p class="terminal-comment"># 本机：登录集群</p><p><span class="terminal-prompt">$</span> ssh hkust-hpc2</p>
        <p class="terminal-comment terminal-space"># 登录节点：提交作业</p><p><span class="terminal-prompt">$</span> sbatch hello.sbatch</p>
        <p class="terminal-output">Submitted batch job &lt;作业号&gt;</p>
        <p class="terminal-comment terminal-space"># 登录节点：查看状态</p><p><span class="terminal-prompt">$</span> squeue -u "$USER"<span class="terminal-cursor"></span></p>
      </div>
      <div class="terminal-caption"><span class="status-dot"></span>示例命令与输出，非实时集群状态</div>
    </div>
  </section>

  <section class="workflow-section" aria-labelledby="workflow-heading">
    <div class="section-heading"><div><span class="section-kicker">执行位置</span><h2 id="workflow-heading">本机、登录节点与计算节点</h2></div><a class="text-link" href="/guide/hpc-overview/">节点说明<Icon name="arrow" size={16} /></a></div>
    <div class="workflow-grid">
      <article class="workflow-card"><div class="workflow-top"><span class="workflow-icon"><Icon name="monitor" size={24} /></span><span class="step-number">01 / LOCAL</span></div><h3>本机</h3><p>编写代码，上传数据，下载结果。</p><span class="workflow-chip">ssh · rsync · scp</span></article>
      <article class="workflow-card"><div class="workflow-top"><span class="workflow-icon"><Icon name="terminal" size={24} /></span><span class="step-number">02 / LOGIN</span></div><h3>登录节点</h3><p>管理文件，提交作业，查询队列；不用于计算。</p><span class="workflow-chip">sbatch · squeue · scancel</span></article>
      <article class="workflow-card"><div class="workflow-top"><span class="workflow-icon"><Icon name="cpu" size={24} /></span><span class="step-number">03 / COMPUTE</span></div><h3>计算节点</h3><p>由 Slurm 分配，运行训练、评估与调试。</p><span class="workflow-chip">srun · python · nvidia-smi</span></article>
    </div>
  </section>

  <section class="notice-section" aria-labelledby="notice-heading">
    <div class="section-heading"><div><span class="section-kicker">使用须知</span><h2 id="notice-heading">使用前需要了解的五点</h2></div><a class="text-link" href="/guide/quickstart/">快速开始<Icon name="arrow" size={16} /></a></div>
    <ol class="notice-grid">
      <li class="notice-item"><span class="notice-number">01</span><h3>登录节点不用于计算</h3><p>训练、评估和大量计算通过 Slurm 提交到计算节点运行。</p></li>
      <li class="notice-item"><span class="notice-number">02</span><h3>提交不等于运行</h3><p><code>sbatch</code> 只是提交申请；<code>PD</code> 为排队中，<code>R</code> 为正在运行。</p></li>
      <li class="notice-item"><span class="notice-number">03</span><h3>运行中持续计费</h3><p>程序空转同样计费。断开 SSH 不会停止作业，不再需要时用 <code>scancel</code> 取消。</p></li>
      <li class="notice-item"><span class="notice-number">04</span><h3>调试使用 debug 分区</h3><p>免费，单次最长 30 分钟，仅用于调试；确认无误后再提交正式作业。</p></li>
      <li class="notice-item"><span class="notice-number">05</span><h3>重要结果自行备份</h3><p>平台不承诺永久保存数据，论文数据和最终模型应定期下载。</p></li>
    </ol>
  </section>

  <section class="path-section" aria-labelledby="path-heading">
    <div class="section-heading"><div><span class="section-kicker">阅读顺序</span><h2 id="path-heading">按使用阶段组织的章节</h2></div><span class="section-count">{chapterCount} 个章节</span></div>
    <div class="path-grid">{readingPath.map((stage) => (
      <div class="path-column">
        <div class="path-head"><h3>{stage.label}</h3><span>{stage.range}</span></div>
        {stage.items.map((document) => <a class="path-link" href={documentHref(document)}><span class="path-number">{document.number || '·'}</span><span class="path-text"><strong>{document.title}</strong><small>{document.description}</small></span><Icon name="chevron" class="card-arrow" size={16} /></a>)}
      </div>
    ))}</div>
  </section>

  <section class="home-resources" aria-labelledby="resources-heading">
    <div class="section-heading"><div><span class="section-kicker">slurm/ 目录</span><h2 id="resources-heading">作业脚本模板</h2></div><a class="text-link" href="/scripts/">全部脚本与模板<Icon name="arrow" size={16} /></a></div>
    <div class="script-grid">{resources.filter((item) => item.group === 'Slurm 脚本').map((resource) => <a class="script-card" href={resourceHref(resource)}><div class="script-card-top"><Icon name="code" size={20} /><span>{resource.slug === 'debug-cpu' ? '免费 · 仅调试' : resource.slug === 'train-gpu' ? 'GPU' : 'CPU'}</span></div><h3>{resource.title}</h3><p>{resource.specification}</p><div class="script-filename">{resource.source.split('/').pop()}<Icon name="arrow" size={16} /></div></a>)}</div>
  </section>

  <section class="home-bottom"><div><span class="eyebrow">适用范围</span><h2>本手册整理使用流程，权限与价格以平台为准。</h2><p>分区、价格与账号配额可能调整，以官方文档、平台实时配置和账单为准。<br class="desktop-break" />本手册为非官方整理，不代表平台承诺。</p></div><a class="button button-secondary" href="/guide/verified-settings/">核验与适用范围<Icon name="arrow" size={17} /></a><small>官方资料核验于 {verifiedAt}</small></section>
</SiteLayout>
