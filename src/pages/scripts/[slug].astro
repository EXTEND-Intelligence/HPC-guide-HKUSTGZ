---
import { Code } from 'astro:components';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { resources } from '../../data/catalog.mjs';
import { readSource } from '../../lib/content';
export function getStaticPaths() {
  return resources.map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}
const { resource } = Astro.props;
const source = readSource(resource.source);
const themes = { light: 'github-light', dark: 'github-dark' } as const;
const language = resource.language as 'bash' | 'python' | 'text' | 'ssh-config';
const isSlurm = resource.group === 'Slurm 脚本';
const headings = [
  ...(isSlurm ? [{ depth: 2, slug: 'submission', text: '提交命令' }] : []),
  { depth: 2, slug: 'full-source', text: '完整源码' },
];
---
<SiteLayout title={resource.title} description={resource.description} headings={headings}>
  <div class="document-header"><div class="breadcrumb"><a href="/scripts/">脚本与模板</a><Icon name="chevron" size={13} /><span>{resource.group}</span></div><div class="eyebrow">{resource.specification}</div><h1>{resource.title}</h1><p>{resource.description}</p><a class="button button-secondary resource-download" href={`/downloads/${resource.source}`} download><Icon name="download" size={17} />下载 {resource.source.split('/').pop()}</a></div>
  {isSlurm && <section class="prose resource-usage"><h2 id="submission">提交命令</h2><p><strong>登录节点：</strong> 在项目根目录执行</p><Code code={`mkdir -p logs\nsbatch ${resource.source}`} lang="bash" themes={themes} defaultColor={false} /><p>提交前确认对应的 Python 环境已建立。<a href={`/guide/${resource.related}/`}>使用说明 →</a></p></section>}
  {!isSlurm && <div class="inline-note"><Icon name="book" size={18} /><p>{resource.slug === 'ssh-config' ? '替换 YOUR_USERNAME 后合并到本机 ~/.ssh/config，不要覆盖原有配置。' : resource.group === 'Python 示例' ? '示例在已分配的计算节点上运行，不在登录节点上训练或做 GPU 测试。' : '安装前确认 Python 环境和 CPU / GPU 依赖类型。'} <a href={`/guide/${resource.related}/`}>使用说明 →</a></p></div>}
  <section class="prose source-code-section"><h2 id="full-source">完整源码</h2><div class="source-file-label"><Icon name="code" size={16} /><span>{resource.source}</span><small>{source.trimEnd().split('\n').length} 行</small></div><Code code={source.trimEnd()} lang={language} themes={themes} defaultColor={false} /></section>
  <a class="text-link resource-back" href="/scripts/">← 返回全部脚本与模板</a>
</SiteLayout>
