---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="页面未找到" home><section class="not-found"><div class="eyebrow">404 · NOT FOUND</div><h1>未找到该页面。</h1><p>页面可能已改名或移动。可返回首页，或使用搜索查找。</p><a class="button button-primary" href="/">返回首页<Icon name="arrow" size={18} /></a></section></SiteLayout>
